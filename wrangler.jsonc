{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shum-net-site",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    // One-page placeholder: every address shows the same page
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
